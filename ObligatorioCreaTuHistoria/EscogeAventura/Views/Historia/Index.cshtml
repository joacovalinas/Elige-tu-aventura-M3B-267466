@using DTOs.DTO.DTOsHistoria
@using EscogeAventura.LogicaNegocios.Entidades
@model List<DTOHistoria>
@{
    ViewData["Title"] = "Historias";

    // Ajustá el texto si tu Estado usa otro valor (ej: "Publicado")
    bool EstaPublicada(DTOHistoria h) =>
        h.Estado != null && h.Estado.StartsWith("Publicad", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h2 class="mb-0">Historias</h2>
    <a asp-controller="Historia" asp-action="AltaHistoria" class="btn btn-primary">Nueva Historia</a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p>No hay historias cargadas.</p>
}
else
{

    <form method="post">

        <div class="acciones mb-3">
            <button type="submit" class="btn btn-primary"
                    formmethod="get" asp-action="EditarHistoria">
                Editar
            </button>

            <button type="submit" formmethod="post" class="btn btn-danger"
                    asp-action="BajaHistoria"
                    onclick="return confirm('¿Seguro que querés eliminar la historia seleccionada?');">
                Eliminar
            </button>

            <button type="submit" class="btn btn-secondary" asp-action="AgregarCapitulo">
                Agregar capítulo
            </button>

            <button type="submit" formmethod="post" class="btn btn-accent" asp-action="Publicar"
                    onclick="return confirm('¿Querés publicar la historia seleccionada?');">
                Publicar
            </button>
        </div>

        <div class="form-card">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 3rem;"></th>
                        <th>Título</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr class="fila-historia position-relative" style="cursor: pointer;">
                            <td>
                                <input type="radio" id="hist-@h.Id" name="id" value="@h.Id" class="form-check-input" required />
                            </td>
                            <td>
                                <label for="hist-@h.Id" class="stretched-link mb-0" style="cursor: pointer;">@h.Titulo</label>
                            </td>
                            <td>
                                @if (EstaPublicada(h))
                                {
                                    <span class="badge-estado badge-publicada">Publicada</span>
                                }
                                else
                                {
                                    <span class="badge-estado badge-no-publicada">No publicada</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
}
