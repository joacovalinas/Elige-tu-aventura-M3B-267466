@* Cliente -> Views/Historia/Index.cshtml *@
@using EscogeAventura.Cliente.Models.DTOs.DTOsHistoria

@model DTOIndexHistoria
@{
    ViewData["Title"] = "Historias";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@* Filtro por categoría (GET, form aparte del de lectura). Solo se puede elegir una *@
<form method="get" asp-controller="Historia" asp-action="Index" class="d-flex align-items-center gap-2 mb-3">
    <label for="categoriaId" class="form-label mb-0">Categoría</label>
    <select id="categoriaId" name="categoriaId" class="form-select w-auto" onchange="this.form.submit()">
        <option value="">Todas</option>
        @foreach (var c in Model.Categorias)
        {
            <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nombre</option>
        }
    </select>
    <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
</form>

@if (!Model.Historias.Any())
{
    <p>@(Model.CategoriaId.HasValue ? "No hay historias en esta categoría." : "No hay historias cargadas.")</p>
}
else
{
    <form id="formLectura" asp-controller="Lectura" asp-action="AltaLectura" method="post">

        <div class="acciones mb-3">
            <button type="button" id="btnLeer" class="btn btn-secondary">
                Leer Historia
            </button>
        </div>

        <div class="form-card">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 3rem;"></th>
                        <th>Título</th>
                        <th>Categorías</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Historias)
                    {
                        <tr class="fila-historia position-relative" style="cursor: pointer;">
                            <td>
                                <input type="radio" id="hist-@h.Id" name="histId" value="@h.Id"
                                       data-titulo="@h.Titulo" class="form-check-input" required />
                            </td>
                            <td>
                                <label for="hist-@h.Id" class="stretched-link mb-0" style="cursor: pointer;">@h.Titulo</label>
                            </td>
                            <td>
                                @foreach (var c in h.CatHistoria)
                                {
                                    <span class="badge rounded-pill me-1"
                                          style="background-color: rgba(46, 217, 163, 0.15); color: var(--color-dark); border: 1px solid rgba(46, 217, 163, 0.4);">
                                        @c
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="modal fade" id="modalNombreLectura" tabindex="-1" aria-labelledby="modalNombreLecturaLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="background-color: var(--color-card); color: var(--color-dark); border: 1px solid rgba(46, 217, 163, 0.25); border-radius: 16px;">
                    <div class="modal-header" style="border-bottom: 1px solid rgba(46, 217, 163, 0.15);">
                        <h5 class="modal-title" id="modalNombreLecturaLabel">Nueva lectura</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">Vas a leer: <strong id="tituloSeleccionado"></strong></p>
                        <label for="Nombrelectura" class="form-label">Nombre de la lectura</label>
                        <input type="text" id="Nombrelectura" name="Nombrelectura" class="form-control"
                               maxlength="60" placeholder="Ej: Mi primera aventura" required />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid rgba(46, 217, 163, 0.15);">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Empezar a leer</button>
                    </div>
                </div>
            </div>
        </div>

    </form>
}

@section Scripts {

    <script>
        // Script para abrir el cuadro que pide el nombre de lectura y validar que haya una historia seleccionada
        (function () {
            const form = document.getElementById('formLectura');
            if (!form) return;

            const modalEl = document.getElementById('modalNombreLectura');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            const inputNombre = document.getElementById('Nombrelectura');
            const tituloEl = document.getElementById('tituloSeleccionado');

            function abrirModal() {
                const seleccionada = form.querySelector('input[name="histId"]:checked');

                if (!seleccionada) {
                    form.querySelector('input[name="histId"]').reportValidity();
                    return;
                }

                tituloEl.textContent = seleccionada.dataset.titulo;
                modal.show();
            }

            document.getElementById('btnLeer').addEventListener('click', abrirModal);

            modalEl.addEventListener('shown.bs.modal', function () { inputNombre.focus(); });
            modalEl.addEventListener('hidden.bs.modal', function () { inputNombre.value = ''; });

            form.addEventListener('submit', function (e) {
                if (!modalEl.classList.contains('show')) {
                    e.preventDefault();
                    abrirModal();
                }
            });
        })();
    </script>
}