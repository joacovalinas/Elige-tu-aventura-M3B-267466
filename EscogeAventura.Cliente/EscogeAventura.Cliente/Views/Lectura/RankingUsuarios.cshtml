@using EscogeAventura.Cliente.Models.DTOs
@model List<DTORankingUsuarios>
@{
    ViewData["Title"] = "Ranking de usuarios";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <h2 class="mb-1">Usuarios con más historias leídas</h2>
            <p class="text-muted mb-4">Cantidad de historias distintas que cada usuario leyó hasta un final.</p>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            else if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info">Todavía no hay usuarios que hayan completado historias.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 60px;">#</th>
                                <th scope="col">Usuario</th>
                                <th scope="col" class="text-end w-25">Historias</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@Model[i].Usuario</td>
                                    <td class="text-end">@Model[i].CantidadHistorias</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>
