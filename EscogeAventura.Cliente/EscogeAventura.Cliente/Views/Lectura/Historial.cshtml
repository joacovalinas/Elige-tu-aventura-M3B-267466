@model List<EscogeAventura.Cliente.Models.DTOs.DTOsLectura.DTOLecturaHistorial>
@{
    ViewData["Title"] = "Mi historial";
    string mes = ViewBag.Mes as string ?? "";
}

<div class="container">
    <h2 class="mb-4">Mi historial de lecturas</h2>

    <form method="get" asp-controller="Lectura" asp-action="Historial" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label for="mes" class="form-label">Filtrar por mes</label>
            <input type="month" id="mes" name="mes" value="@mes" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Historial" class="btn btn-outline-secondary ms-1">Ver todas</a>
        </div>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No hay lecturas para mostrar.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th>Lectura</th>
                        <th>Historia</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Final alcanzado</th>
                        <th>Capítulo actual</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td>
                                @if (l.FechaFin.HasValue)
                                {
                                    <i class="bi bi-check-circle-fill text-success me-1" title="Finalizada"></i>
                                }
                                else
                                {
                                    <i class="bi bi-hourglass-split text-warning me-1" title="En curso"></i>
                                }
                                @l.Nombrelectura
                            </td>
                            <td>@l.NomHistoria</td>
                            <td>@l.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@(l.FechaFin?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(l.Final ?? "-")</td>
                            <td>@(l.FechaFin.HasValue ? "-" : (l.CapituloActual ?? "-"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="small text-muted mt-2">
            <i class="bi bi-check-circle-fill text-success me-1"></i>Finalizada
            <i class="bi bi-hourglass-split text-warning ms-3 me-1"></i>En curso
        </div>
    }
</div>