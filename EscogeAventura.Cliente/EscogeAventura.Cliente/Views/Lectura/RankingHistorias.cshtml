@using EscogeAventura.Cliente.Models.DTOs.DTOsLectura
@model List<DTORankingHistorias>
@{
    ViewData["Title"] = "Ranking de historias";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <h2 class="mb-1">Ranking de historias</h2>
            <p class="text-muted mb-4">Historias ordenadas por cantidad de lecturas.</p>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info">Todavía no hay lecturas registradas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Historia</th>
                                <th scope="col" class="text-end w-25">Lecturas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td>@c.Historia</td>
                                    <td class="text-end">@c.CantidadLecturas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>